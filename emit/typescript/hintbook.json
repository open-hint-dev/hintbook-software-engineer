{
    "id": "emit-se-typescript",
    "target": "typescript",
    "match": [
        "*.ts",
        "*.tsx",
        "*.mts",
        "*.cts"
    ],
    "comment": "// {text}",
    "symbols": "npx --yes @openhint/adapter-typescript {file}",
    "extract": {
        "function": "func",
        "interface": "entity",
        "type": "entity",
        "class": "entity",
        "enum": "entity",
        "const": "data",
        "param": "arg",
        "field": "field",
        "result": "result"
    },
    "builtins": [
        "string",
        "number",
        "boolean",
        "bigint",
        "symbol",
        "object",
        "void",
        "any",
        "unknown",
        "never",
        "null",
        "undefined",
        "true",
        "false",
        "Array",
        "Promise",
        "Record",
        "Partial",
        "Readonly",
        "Pick",
        "Omit",
        "Map",
        "Set",
        "Date",
        "Error",
        "RegExp",
        "JSON",
        "Math"
    ]
}
