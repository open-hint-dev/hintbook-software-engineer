{
    "id": "emit-se-go",
    "target": "go",
    "match": [
        "*.go"
    ],
    "comment": "// {text}",
    "extract": {
        "function": "func",
        "struct": "entity",
        "interface": "entity",
        "const": "data",
        "param": "arg",
        "field": "field",
        "result": "result"
    },
    "builtins": [
        "string",
        "int",
        "int8",
        "int16",
        "int32",
        "int64",
        "uint",
        "uint8",
        "uint16",
        "uint32",
        "uint64",
        "float32",
        "float64",
        "complex64",
        "complex128",
        "bool",
        "byte",
        "rune",
        "error",
        "any",
        "interface",
        "struct",
        "map",
        "chan",
        "nil"
    ]
}
